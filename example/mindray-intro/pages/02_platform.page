pageType: content
background: {type: solid, color: "#FFFFFF"}
elements:
  - elementId: hd-marker
    elementType: text
    bounds: [48, 30, 18, 30]
    content:
      align: [left, middle]
      wrap: false
      text: |
        <p><span style="font-size:20px;color:$primary;font-weight:700">❯</span></p>
  - elementId: hd-title
    elementType: text
    bounds: [72, 30, 840, 30]
    content:
      style: "$pageTitle"
      align: [left, middle]
      wrap: false
      text: 三大业务板块构成全球化医疗器械平台
  - elementId: hd-subtitle
    elementType: text
    bounds: [72, 62, 840, 16]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: 覆盖生命信息与支持、体外诊断、医学影像三大领域的科室级整体方案
  - elementId: hd-rule
    elementType: shape
    bounds: [48, 90, 864, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: card-1
    elementType: shape
    bounds: [48, 110, 176, 180]
    shapeName: rect
    fill: {type: solid, color: "#FFFFFF"}
    border: {style: solid, width: 1, color: "$line"}
  - elementId: card-1-icon
    elementType: icon
    bounds: [64, 126, 28, 28]
    iconName: "fas:heart-pulse"
    fill: {type: solid, color: "$primary"}
  - elementId: card-1-title
    elementType: text
    bounds: [64, 162, 144, 20]
    content:
      align: [left, middle]
      wrap: false
      text: |
        <p><span style="font-size:14px;color:$primary;font-weight:700">生命信息与支持</span></p>
  - elementId: card-1-en
    elementType: text
    bounds: [64, 184, 144, 14]
    content:
      style: "$footnote"
      align: [left, middle]
      wrap: false
      text: PMLS
  - elementId: card-1-body
    elementType: text
    bounds: [64, 204, 144, 72]
    content:
      style: "$bodyText"
      fontSize: 10
      align: [left, top]
      text: 监护仪、麻醉机、呼吸机、除颤仪等重症与围术期核心设备
  - elementId: card-2
    elementType: shape
    bounds: [236, 110, 176, 180]
