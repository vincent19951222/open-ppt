    fill: {type: solid, color: "$primary"}
  - elementId: card-2-title
    elementType: text
    bounds: [252, 162, 144, 20]
    content:
      align: [left, middle]
      wrap: false
      text: |
        <p><span style="font-size:14px;color:$primary;font-weight:700">体外诊断</span></p>
  - elementId: card-2-en
    elementType: text
    bounds: [252, 184, 144, 14]
    content:
      style: "$footnote"
      align: [left, middle]
      wrap: false
      text: IVD
  - elementId: card-2-body
    elementType: text
    bounds: [252, 204, 144, 72]
    content:
      style: "$bodyText"
      fontSize: 10
      align: [left, top]
      text: 血液、生化、免疫、凝血等实验室诊断仪器与配套试剂
  - elementId: card-3
    elementType: shape
    bounds: [424, 110, 176, 180]
    shapeName: rect
