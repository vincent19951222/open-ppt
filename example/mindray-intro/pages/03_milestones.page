  - elementId: step-4
    effect: fly-in
    direction: right
    trigger: afterPrevious
    durationMs: 350
  - elementId: step-5
    effect: fly-in
    direction: right
    trigger: afterPrevious
    durationMs: 350
  - elementId: note-1
    effect: fade-in
    trigger: afterPrevious
    durationMs: 400
  - elementId: note-2
    effect: fade-in
    trigger: withPrevious
    durationMs: 400
    delayMs: 150
