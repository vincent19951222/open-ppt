pageType: content
background: {type: solid, color: "#FFFFFF"}
elements:
  - elementId: hd-marker
    elementType: text
    bounds: [48, 30, 18, 30]
    content:
      align: [left, middle]
      wrap: false
      text: |
        <p><span style="font-size:20px;color:$primary;font-weight:700">❯</span></p>
  - elementId: hd-title
    elementType: text
    bounds: [72, 30, 840, 30]
    content:
      style: "$pageTitle"
      align: [left, middle]
      wrap: false
      text: 三十余年完成从单品突破到全球平台的跨越
  - elementId: hd-subtitle
    elementType: text
    bounds: [72, 62, 840, 16]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: 关键发展里程碑（红色 = 已完成阶段，灰色 = 进行中的新阶段）
  - elementId: hd-rule
    elementType: shape
    bounds: [48, 90, 864, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: step-1
    elementType: shape
    bounds: [48, 140, 176, 48]
    shapeName: chevron
    fill: {type: solid, color: "$primary"}
  - elementId: step-1-text
    elementType: text
    bounds: [56, 140, 160, 48]
    content:
      align: [center, middle]
      wrap: false
      text: |
        <p><span style="font-size:11px;color:#FFFFFF;font-weight:700">1991 深圳创立</span></p>
  - elementId: step-2
    elementType: shape
