    elementType: text
    bounds: [64, 304, 392, 72]
    content:
      style: "$bodyText"
      fontSize: 10
      align: [left, top]
      text: |
        <p><span style="font-size:12px;color:$primary;font-weight:700">国际化路径</span></p>
        <p style="margin-top:6px">通过并购 Datascope 监护业务、Zonare 超声等进入欧美主流市场，海外收入占比持续提升</p>
  - elementId: note-2
    elementType: shape
    bounds: [488, 292, 424, 96]
    shapeName: rect
    fill: {type: solid, color: "$panelSoft"}
  - elementId: note-2-text
    elementType: text
    bounds: [504, 304, 392, 72]
    content:
      style: "$bodyText"
      fontSize: 10
      align: [left, top]
      text: |
        <p><span style="font-size:12px;color:$primary;font-weight:700">高端化路径</span></p>
        <p style="margin-top:6px">高端监护、超声与化学发光产品进入海外高端医院，国内市场持续实现进口替代</p>
  - elementId: takeaway-bar
    elementType: shape
    bounds: [48, 452, 864, 40]
    shapeName: rect
    fill: {type: solid, color: "$panel"}
  - elementId: takeaway-text
    elementType: text
    bounds: [72, 452, 820, 40]
    content:
      align: [left, middle]
      text: |
        <p><span style="font-size:11px;color:$primary;font-weight:700">❯ </span><span style="font-size:11px;color:$ink">每一步跨越围绕同一主线：让优质医疗科技更可及</span></p>
  - elementId: ft-source
    elementType: text
    bounds: [48, 512, 400, 14]
    content:
      style: "$footnote"
      align: [left, middle]
      wrap: false
      text: 资料来源：迈瑞医疗公开资料及公司官网
  - elementId: ft-pagenum
    elementType: text
    bounds: [736, 512, 64, 14]
    content:
      style: "$footnote"
      align: [right, middle]
      wrap: false
      text: 03 / 04
  - elementId: ft-logo
    elementType: image
    bounds: [812, 503, 104, 23]
    src: "media/mindray-lockup-wide.png"
    fit: {mode: contain}
animations:
